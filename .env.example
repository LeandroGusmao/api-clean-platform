NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://api_clean_platform:api_clean_platform_local_dev@localhost:5432/api_clean_platform

# Redis behind the rate limit of every route that declares its own ceiling
# (login, register, the password and e-mail routes). REQUIRED, with no default.
# With Redis down those routes answer 503; every other route is unaffected.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=250

JWT_SECRET=a-development-secret-with-32-chars-min

# The `iss` and `aud` claims of the access token. REQUIRED, with no default:
# two deployments sharing a value would accept each other's tokens, which is
# what these claims exist to prevent. Give each deployment its own name.
JWT_ISSUER=api-clean-platform
JWT_AUDIENCE=api-clean-platform

# OAuth client id from Google Cloud Console (public, not a secret). REQUIRED:
# the process will not boot without it. Any non-empty value lets it start; a
# real one is needed for POST /auth/google to accept a token.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Connection limits. Defaults shown; see specs/2026-08-30-connection-limits-design.md §4
# before raising the pool — the ceiling is instances x POOL_MAX <= max_connections.
# A value of 0 on a timeout does not disable it: it leaves the server's setting in effect.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Which proxies may speak for the client, deciding whether request.ip means
# anything. Leave EMPTY when nothing sits in front of the API.
#
# Only a comma-separated list of trusted networks is accepted, e.g.
# TRUST_PROXY=10.0.0.0/8,loopback
#
# Both `true` and a hop count are REFUSED at boot, and the boot message says
# why: `true` trusts the leftmost X-Forwarded-For entry, which the client
# writes; and a number is silently inoperative in Fastify 5 — it is accepted
# and then trusts no one, so the limiter would see the balancer's address for
# every request and ban the whole world at once.
TRUST_PROXY=

# Per-address request ceiling for every route that does not declare its own. A
# flood guard, not a UX limit — the limit that matters lives at the edge, which
# sees every replica. This counter is per process, so N replicas mean N times
# the ceiling.
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# The login route's own ceiling, tighter because a request there carries a
# password guess. It counts requests, not failed logins.
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Refresh token (decision 11). Seconds, all three of them. The TTL slides with
# every rotation (an idle timeout); the max lifetime does not (the whole life of
# a session, counted from login).
REFRESH_TOKEN_TTL_SECONDS=5184000
REFRESH_TOKEN_MAX_LIFETIME_SECONDS=7776000
REFRESH_TOKEN_GRACE_WINDOW_SECONDS=30

# The password change route's own ceiling. Same reasoning as the login one: the
# request carries a password guess, and it counts requests, not failures.
PASSWORD_CHANGE_RATE_LIMIT_MAX_REQUESTS=10
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=60

# The account deletion route's own ceiling, for the same reason: the request
# carries a password guess, and the account it guards cannot be brought back.
ACCOUNT_DELETE_RATE_LIMIT_MAX_REQUESTS=10
ACCOUNT_DELETE_RATE_LIMIT_WINDOW_SECONDS=60

# Mail. Defaults shown point at the Mailpit service in docker-compose.yml —
# its web UI is at http://127.0.0.1:8025, where a local send can be read back.
#
# MAIL_HOST, MAIL_PORT and MAIL_FROM are REQUIRED in production — the process
# refuses to boot without them, rather than silently inheriting these
# development values. MAIL_REQUIRE_TLS must be `true` in production too: the
# schema enforces it, and without STARTTLS a man in the middle reads every
# verification code in plaintext.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
# Quoted: `source .env` would otherwise read `<` as shell redirection.
MAIL_FROM="API Clean Platform <no-reply@localhost>"
# MAIL_USER=
# MAIL_PASSWORD=

# Email verification (§2 and §6.2 of the design spec). The code is only six
# digits — the TTL, the attempt cap and the resend cooldown together are what
# substitute for entropy, so lengthening one changes what the other two owe.
EMAIL_VERIFICATION_TTL_SECONDS=900
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Registration now sends mail to an arbitrary address from an anonymous
# request, which makes it a spam amplifier — its own ceiling, not the global
# one, for the reason the login pair above already documents.
REGISTER_RATE_LIMIT_MAX_REQUESTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=60

# The confirm-email route's own ceiling: a request there carries a code guess.
EMAIL_VERIFY_RATE_LIMIT_MAX_REQUESTS=10
EMAIL_VERIFY_RATE_LIMIT_WINDOW_SECONDS=60

# The resend route's own ceiling, tighter than the two above: an anonymous
# request here both spams a stranger's inbox and can burn their live code.
EMAIL_VERIFY_RESEND_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_VERIFY_RESEND_RATE_LIMIT_WINDOW_SECONDS=60

# How long a dead token row survives past its expiry before the cron prunes it
# (docs/superpowers/specs/2026-09-07-token-pruning-cron-design.md §3.4). Seconds.
# A longer window is a bigger post-mortem trail and a bigger table. One per
# table because the trail worth keeping differs.
REFRESH_TOKEN_PRUNE_RETENTION_SECONDS=604800
PENDING_REGISTRATION_PRUNE_RETENTION_SECONDS=86400
PASSWORD_RESET_TOKEN_PRUNE_RETENTION_SECONDS=86400

# Outbox dispatch retry cap, batch size, how long a settled row survives before
# the cron prunes it, and how long a run's claim on a message lasts. The claim
# must outlast a stalled SMTP send (50 s at the shipped timeouts) or two runs
# send the same message; it is also the wait between two attempts at a message
# whose send failed.
OUTBOX_DISPATCH_MAX_ATTEMPTS=5
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_DISPATCH_LEASE_SECONDS=120
OUTBOX_MESSAGE_PRUNE_RETENTION_SECONDS=604800
