NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://api_clean_platform:api_clean_platform_local_dev@localhost:5432/api_clean_platform
JWT_SECRET=a-development-secret-with-32-chars-min

# Connection limits. Defaults shown; see specs/2026-08-30-connection-limits-design.md §4
# before raising the pool — the ceiling is instances x POOL_MAX <= max_connections.
# A value of 0 on a timeout does not disable it: it leaves the server's setting in effect.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Refresh token (decision 11). Seconds, both of them.
REFRESH_TOKEN_TTL_SECONDS=5184000
REFRESH_TOKEN_GRACE_WINDOW_SECONDS=30
