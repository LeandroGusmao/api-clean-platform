{
  "name": "api-clean-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.7.0"
  },
  "packageManager": "pnpm@11.7.0",
  "imports": {
    "#modules/*": {
      "development": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#shared/*": {
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#infra/*": {
      "development": "./src/infra/*.ts",
      "default": "./dist/infra/*.js"
    }
  },
  "scripts": {
    "dev": "node --watch --conditions=development --env-file-if-exists=.env --import tsx src/main/http.ts",
    "build": "tsc",
    "start": "node dist/main/http.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.13.3",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
