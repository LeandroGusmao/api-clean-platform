{
  "name": "api-clean-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.7.0"
  },
  "packageManager": "pnpm@11.7.0",
  "imports": {
    "#modules/*": {
      "development": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#shared/*": {
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#infra/*": {
      "development": "./src/infra/*.ts",
      "default": "./dist/infra/*.js"
    },
    "#main/*": {
      "development": "./src/main/*.ts",
      "default": "./dist/main/*.js"
    }
  },
  "scripts": {
    "dev": "node --watch --conditions=development --env-file-if-exists=.env --import tsx src/main/http.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --conditions=development --env-file-if-exists=.env --import tsx src/main/seeds/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@node-rs/argon2": "2.1.0",
    "bowser": "2.14.1",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.3",
    "nodemailer": "9.1.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
