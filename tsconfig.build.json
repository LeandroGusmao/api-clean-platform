{
  // The only config that emits. Narrow on purpose: specs are colocated with the
  // code they cover, and `tsc` emits everything it typechecks — so keeping them
  // out of `dist/` means keeping them out of this file's inputs.
  //
  // `fixtures/`, `seeds/` and `reset/` are excluded on the same grounds as
  // `in-memory/` below. `fixtures/` holds test-only data — including a
  // hardcoded JWT secret — `seeds/` holds development data with a published
  // password, and `reset/` drops and recreates the schema it points at; none
  // of the three has business in a published build. All are globs, not
  // paths, so any module may add any of them and get the exclusion for free.
  //
  // `in-memory/` is excluded for the same reason one step removed: those
  // repositories live under `src/` because the unit tests of the pure layer
  // need them, but they are test doubles. Shipping one means
  // every derived app carries a repository that silently accepts a duplicate
  // id, one import away from a container. Nothing in production imports them,
  // so if that ever changes the build fails loudly — which is the right
  // failure.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/in-memory/**",
    "**/fixtures/**",
    "**/seeds/**",
    "**/reset/**"
  ]
}
