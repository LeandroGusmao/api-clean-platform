{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2024",
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "types": ["node"],

    "customConditions": ["development"],

    // This config never emits: it exists so the editor and `pnpm typecheck`
    // see the whole repository, tests included, under the same strictness.
    // Every emit concern — `rootDir`, `outDir`, `sourceMap` — lives in
    // tsconfig.build.json instead. `rootDir: "src"` in particular would break
    // here, since `tests/` sits outside it.
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "drizzle.config.ts"]
}
